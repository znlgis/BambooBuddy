{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bamboo Buddy",
  "version": "0.1.0",
  "identifier": "com.bamboo.buddy",
  "build": {
    "frontendDist": "../../site/dist"
  },
  "app": {
    "windows": [
      {
        "title": "熊猫宝宝的一天 · Bamboo Buddy",
        "width": 500,
        "height": 920,
        "minWidth": 400,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "backgroundColor": "#faf3e7"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
